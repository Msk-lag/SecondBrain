{
  "name": "secondbrain",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @secondbrain/db run test:integration && pnpm --filter api run test:integration && pnpm --filter worker run test:integration",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "lint": "pnpm -r --if-present run lint",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm test",
    "coverage:diff": "bash scripts/check-diff-coverage.sh",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "duplication": "jscpd",
    "scan:secrets": "secretlint --no-gitignore \"**/*\"",
    "scan:secrets:staged": "node scripts/scan-staged-secrets.mjs",
    "poc:vector": "tsx scripts/poc/mariadb-vector-poc.ts",
    "poc:seed-graph": "tsx scripts/poc/seed-graph-load.ts",
    "db:generate": "pnpm --filter @secondbrain/db run db:generate",
    "db:migrate": "pnpm --filter @secondbrain/db run db:migrate",
    "db:seed": "pnpm --filter @secondbrain/db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "lint-staged": "^17.0.8",
    "mysql2": "^3.22.5",
    "prettier": "^3.9.4",
    "secretlint": "^13.0.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
