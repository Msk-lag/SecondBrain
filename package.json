{
  "name": "secondbrain",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "poc:vector": "tsx scripts/poc/mariadb-vector-poc.ts",
    "db:generate": "pnpm --filter @secondbrain/db run db:generate",
    "db:migrate": "pnpm --filter @secondbrain/db run db:migrate",
    "db:seed": "pnpm --filter @secondbrain/db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "mysql2": "^3.22.5",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  }
}
